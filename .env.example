# =============================================================================
# EKAP NextJS MFE - Environment Variables Example
# Copy this file to .env and fill in the values
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ekap_db
POSTGRES_USER=ekap_user
POSTGRES_PASSWORD=changeme

# ---- Weaviate ----
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_DOCUMENT_UPLOADED=document.uploaded
KAFKA_TOPIC_DOCUMENT_PROCESSED=document.processed
KAFKA_TOPIC_HR_EVENTS=hr.events
KAFKA_GROUP_ID=ekap-group

# ---- Chat Service (FastAPI) ----
CHAT_SERVICE_HOST=0.0.0.0
CHAT_SERVICE_PORT=8000
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# ---- Doc Processor (FastAPI) ----
DOC_PROCESSOR_HOST=0.0.0.0
DOC_PROCESSOR_PORT=8001
DOC_UPLOAD_DIR=/tmp/ekap-uploads

# ---- HR Service (Spring Boot) ----
HR_SERVICE_PORT=8080
HR_SERVICE_DB_URL=jdbc:postgresql://localhost:5432/ekap_db
HR_SERVICE_DB_USERNAME=ekap_user
HR_SERVICE_DB_PASSWORD=changeme

# ---- Frontend Shell (Next.js) ----
NEXT_PUBLIC_CHAT_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_HR_SERVICE_URL=http://localhost:8080
NEXT_PUBLIC_DOC_PROCESSOR_URL=http://localhost:8001
NEXT_PUBLIC_REMOTE_HR_NAMECHANGE_URL=http://localhost:3001

# ---- Frontend Remote: hr-namechange (Next.js) ----
HR_NAMECHANGE_PORT=3001

# ---- JWT / Auth ----
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_EXPIRY_SECONDS=3600

# ---- Logging ----
LOG_LEVEL=INFO
